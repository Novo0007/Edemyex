
{
  "entities": {
    "Developer": {
      "title": "Developer",
      "type": "object",
      "description": "A developer using Weblock to protect their Chrome extensions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["developer", "admin"] },
        "profileImageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Extension": {
      "title": "Extension",
      "type": "object",
      "description": "A Chrome extension registered on the Weblock platform.",
      "properties": {
        "id": { "type": "string" },
        "developerId": { "type": "string", "description": "The UID of the developer owner." },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "locked", "maintenance"] },
        "secretKey": { "type": "string", "description": "Private key for SDK authentication." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "developerId", "name", "status", "secretKey"]
    },
    "License": {
      "title": "License",
      "type": "object",
      "description": "A license key issued to an end-user for a specific extension.",
      "properties": {
        "id": { "type": "string" },
        "extensionId": { "type": "string" },
        "key": { "type": "string", "description": "The actual license key string." },
        "userEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "extensionId", "key", "userEmail", "status"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/Developer" },
      "description": "Store for developer user profiles."
    },
    "/extensions/{extensionId}": {
      "schema": { "$ref": "#/backend/entities/Extension" },
      "description": "Root collection for all protected extensions."
    },
    "/extensions/{extensionId}/licenses/{licenseId}": {
      "schema": { "$ref": "#/backend/entities/License" },
      "description": "Sub-collection for license keys associated with a specific extension."
    }
  }
}
