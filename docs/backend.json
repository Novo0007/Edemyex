
{
  "entities": {
    "Extension": {
      "title": "Extension",
      "type": "object",
      "description": "A Chrome extension being managed by the platform.",
      "properties": {
        "id": { "type": "string" },
        "developerId": { "type": "string", "description": "The UID of the developer who owns this extension." },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "locked", "maintenance"] },
        "secretKey": { "type": "string", "description": "Private key used for extension-to-backend communication." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "developerId", "name", "status", "secretKey"]
    },
    "License": {
      "title": "License",
      "type": "object",
      "description": "A license key for a specific extension and end-user.",
      "properties": {
        "id": { "type": "string" },
        "extensionId": { "type": "string" },
        "key": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "extensionId", "key", "userEmail", "status"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "A developer using GuardExt.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["developer", "admin"] }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Developer profiles."
    },
    "/extensions/{extensionId}": {
      "schema": { "$ref": "#/entities/Extension" },
      "description": "Metadata for registered extensions."
    },
    "/extensions/{extensionId}/licenses/{licenseId}": {
      "schema": { "$ref": "#/entities/License" },
      "description": "License keys issued for a specific extension."
    }
  }
}
