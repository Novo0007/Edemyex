
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /extensions/{extensionId} {
      // Developers can manage their own extensions
      allow read, write: if isSignedIn() && (resource == null || resource.data.developerId == request.auth.uid);
      
      match /licenses/{licenseId} {
        allow read, write: if isSignedIn() && get(/databases/$(database)/documents/extensions/$(extensionId)).data.developerId == request.auth.uid;
      }
    }
  }
}
