/**
 * @file Firestore Security Rules for Edemy.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles, purchases, and recommendations.
 * Course ownership is based on the `creatorId` field within the course document.
 * Admins have elevated privileges to manage users and courses.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /courses/{courseId}: Stores course information.
 * - /users/{userId}/purchases/{purchaseId}: Stores purchase records for each user.
 * - /users/{userId}/recommendations/{recommendationId}: Stores AI-generated course recommendations for each user.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data, purchases, and recommendations.
 * - Admins can read and write all user and course data for management purposes.
 * - Courses can be read by anyone, but only the creator or an admin can update or delete them.
 * - Listing of user-specific purchases and recommendations is restricted to the owning user.
 * - The rules prioritize security and simplicity, avoiding complex queries and external data lookups.
 *
 * Denormalization for Authorization:
 * - Course documents include a `creatorId` field to directly associate courses with their creators.
 * - User documents include a `role` field ('user', 'creator', 'admin') to manage permissions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to user profile data based on user ID or admin role.
     * @path /users/{userId}
     * @allow (create) A user can create their own profile.
     * @allow (get, update, delete) A user can access their own profile.
     * @allow (list, get, update) An admin can access any user's profile.
     * @principle Enforces document ownership for user profiles, with admin override.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Allows public read access to course data. Creation, updates, and deletions are restricted to the course creator or an admin.
     * @path /courses/{courseId}
     * @allow (get, list) Any user can read course data.
     * @allow (create) An authenticated user can create a course.
     * @allow (update, delete) The course owner or an admin can update/delete the course.
     * @principle Allows public reads but enforces ownership or admin privileges for writes.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isCourseOwner(resource.data.creatorId) || isAdmin());
    }

    /**
     * @description Allows access to purchase records for a specific user.
     * @path /users/{userId}/purchases/{purchaseId}
     * @allow (get, list, create, update, delete) A user can manage their own purchase records.
     * @principle Restricts access to a user's own purchase records.
     */
    match /users/{userId}/purchases/{purchaseId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows access to AI-generated course recommendations for a specific user.
     * @path /users/{userId}/recommendations/{recommendationId}
     * @allow (get, list, create, update, delete) A user can manage their own recommendations.
     * @principle Restricts access to a user's own AI-generated course recommendations.
     */
    match /users/{userId}/recommendations/{recommendationId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isCourseOwner(creatorId) {
        return request.auth.uid == creatorId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
