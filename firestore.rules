// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Courses: public read; creator or admin can write
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isCourseOwner(resource.data.creatorId) || isAdmin());
    }

    // Purchases: private under each user
    match /users/{userId}/purchases/{purchaseId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Recommendations: private under each user (if used)
    match /users/{userId}/recommendations/{recommendationId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }
    
    // Top-level purchases collection rules
    match /purchases/{purchaseId} {
      // Allow user who made purchase OR the creator of the course to read.
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isCourseOwner(resource.data.creatorId));

      // Allow creators to query their own sales
      allow list: if isSignedIn() && request.query.where[0][0] == 'creatorId' && request.query.where[0][2] == request.auth.uid;

      // Allow authenticated users to create purchases for themselves
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);

      // Disallow updates and deletes for data integrity
      allow update, delete: if false;
    }


    match /users/{userId} {
      // A user can read their own document, or an admin can read any user document.
      // Public reads of creator profiles are removed to protect payoutDetails.
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // Allow queries on the users collection. The more restrictive `get` rule above will
      // be enforced on each document returned by the query, ensuring data security.
      allow list: if isSignedIn();

      // Only the user or an admin can modify their own profile.
      allow update, delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // Anyone can create their own user document when signing up.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isCourseOwner(creatorId) {
      return request.auth.uid == creatorId;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
