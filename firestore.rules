// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: owner-only access; admins can manage; only admins can list all users
    match /users/{userId} {
      allow get, update, delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
    }

    // Courses: public read; creator or admin can write
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isCourseOwner(resource.data.creatorId) || isAdmin());
    }

    // Purchases: private under each user
    match /users/{userId}/purchases/{purchaseId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Recommendations: private under each user (if used)
    match /users/{userId}/recommendations/{recommendationId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    match /users/{userId} {
  // Allow reads of approved creator profiles; owner and admin can read as well
  allow read: if
    (resource.data.creatorStatus == 'approved') ||
    (isSignedIn() && (isOwner(userId) || isAdmin()));

  // Only admins can list all users (optional: keep this if you still want to block full scans)
  // Note: If you keep this 'list' line as admin-only, queries by non-admins will still work
  // because the broader 'read' condition above permits the documents they return.
  allow list: if isSignedIn() && isAdmin();

  // Writes restricted
  allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
  allow update, delete: if isSignedIn() && (isOwner(userId) || isAdmin());
}

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isCourseOwner(creatorId) {
      return request.auth.uid == creatorId;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}