/**
 * @file Firestore Security Rules for Edemy.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for private data (profiles, purchases, recommendations)
 * and a creator-ownership model for public course data. It implements Role-Based Access Control (RBAC)
 * to grant special permissions to 'creator' and 'admin' roles, with admins having universal management privileges.
 * The rules are designed for security, performance, and clarity.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, roles, and creator status.
 * - /courses/{courseId}: Stores course information, owned by a creator.
 * - /users/{userId}/purchases/{purchaseId}: Private subcollection for a user's purchase history.
 * - /users/{userId}/recommendations/{recommendationId}: Private subcollection for a user's AI recommendations.
 *
 * Key Security Decisions:
 * - Default to deny: Access is only granted if a rule explicitly allows it.
 * - User data is private: Users can only read and write their own documents in the `/users` collection and its subcollections.
 * - Creator content is protected: Only the user who created a course (or an admin) can update or delete it.
 * - Public data is read-only for most users: Anyone can browse courses, but write access is restricted.
 * - Admins have god-mode: The 'admin' role bypasses most ownership checks for management purposes.
 *
 * Denormalization for Authorization:
 * To avoid slow and costly `get()` calls within rules, authorization data is denormalized.
 * - The `role` ('user', 'creator', 'admin') is stored directly on the user's document.
 * - The `creatorId` is stored directly on the course document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the user profile collection.
     * @path /users/{userId}
     * @allow (get, update, delete) A user can only access their own profile. Admins can access any profile.
     * @allow (list) Only admins can list all users. This prevents users from scraping all user data.
     * @allow (create) An authenticated user can create their own profile document. We enforce that the document ID matches their user ID.
     * @principle Enforces document ownership for user profiles, with a specific override for admins.
     */
    match /users/{userId} {
      allow get, update, delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * @description Secures the public course collection.
     * @path /courses/{courseId}
     * @allow (get, list) Anyone, including unauthenticated users, can view and list courses to browse the platform.
     * @allow (create) An authenticated user can create a course, but we enforce that the `creatorId` in the new document matches their own UID.
     * @allow (update, delete) Only the original course creator or an admin can modify or delete the course.
     * @principle Allows public reads for discoverability but enforces strict ownership or admin privileges for all writes.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isCourseOwner(resource.data.creatorId) || isAdmin());
    }

    /**
     * @description Secures the user-specific purchases subcollection.
     * @path /users/{userId}/purchases/{purchaseId}
     * @allow (read, write) A user can manage their own purchase records (CRUD). No other user can access them.
     * @principle Enforces strict ownership over sensitive subcollections. The rule inherits the `userId` from the path.
     */
    match /users/{userId}/purchases/{purchaseId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Secures the user-specific recommendations subcollection.
     * @path /users/{userId}/recommendations/{recommendationId}
     * @allow (read, write) A user can manage their own AI-generated recommendations. No other user can access them.
     * @principle Enforces strict ownership over sensitive subcollections. The rule inherits the `userId` from the path.
     */
    match /users/{userId}/recommendations/{recommendationId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // --- Helper Functions ---

    /**
     * @description Checks if a user is authenticated.
     * @returns {bool} True if a user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the currently authenticated user is the owner of the document.
     * @param userId The ID of the user document to check against.
     * @returns {bool} True if the requester's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the currently authenticated user is the owner of a course.
     * @param creatorId The ID of the course creator to check against.
     * @returns {bool} True if the requester's UID matches the provided creatorId.
     */
    function isCourseOwner(creatorId) {
        return request.auth.uid == creatorId;
    }
    
    /**
     * @description Checks if the currently authenticated user has the 'admin' role.
     * This function performs a document read to check the user's role.
     * @returns {bool} True if the user is signed in and their role in Firestore is 'admin'.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
