
{
  "manifest_version": 3,
  "name": "Weblock Protection SDK",
  "version": "1.0.0",
  "description": "Enterprise-grade security for your Chrome Extension. Remote locking and license management.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://weblockk.netlify.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Weblock License Manager"
  },
  "icons": {
    "128": "icon128.png"
  }
}
