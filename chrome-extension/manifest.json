
{
  "manifest_version": 3,
  "name": "GuardExt Protected Extension",
  "version": "1.0",
  "description": "Example of an extension protected by GuardExt.",
  "permissions": ["storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.png"
  }
}
